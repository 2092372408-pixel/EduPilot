# ============================================
# EduPilot · AI 学习向导 · 环境配置模板
# 用法：复制本文件为 .env，再填入你的 Key
#   Windows:   copy .env.example .env
#   Mac/Linux: cp .env.example .env
# 注意：.env 含密钥，已在 .gitignore 中排除，请勿提交
# ============================================

# ---------- 1) LLM（必填，否则进入离线演示模式） ----------
# ---------- 1) LLM（可选：也可不改本文件，直接启动后在网页里配置） ----------
# 【推荐】启动服务后打开 http://127.0.0.1:8787 ，首次进入会弹出「配置大模型」向导：
#   选平台 → 填 API Key → 下拉选择模型（可刷新账户列表）→ 测试连接 → 保存（立即生效，无需重启）。
#   向导会把配置写回本文件（按行改写，不影响其它配置），密钥只存本机。
# 本文件留空 = 使用内置演示引擎（Mock 模式，无需任何 Key，也能完整体验功能）。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
# 平台标识（由向导写入；手动配置可省略，程序会按 baseUrl 自动识别）
# LLM_PROVIDER=deepseek

# 支持主流 OpenAI 兼容平台（向导已内置，改上面两行也可手动切换）：
#   DeepSeek:    LLM_BASE_URL=https://api.deepseek.com/v1                              LLM_MODEL=deepseek-flash
#   阿里云百炼:   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1        LLM_MODEL=qwen-plus
#   智谱 GLM:    LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4                     LLM_MODEL=glm-5.3-flash
#   Moonshot:    LLM_BASE_URL=https://api.moonshot.cn/v1                               LLM_MODEL=kimi-k2.6
#   硅基流动:     LLM_BASE_URL=https://api.siliconflow.cn/v1                            LLM_MODEL=Pro/moonshotai/Kimi-K2.6
#   火山方舟:     LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3                 LLM_MODEL=doubao-seed-2-1-lite-260915
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1                            LLM_MODEL=openai/gpt-4o-mini
#   自托管 vLLM:  LLM_BASE_URL=http://127.0.0.1:8000/v1                                LLM_MODEL=your-model

# 注意：智谱的 base 路径含 /paas/v4，火山方舟通常是 /api/v3，不要漏掉版本段，
#      程序会在其后拼接 /chat/completions 与 /models。

# 思考型模型（Qwen3.x 等）：设为 1 关闭思考，降低延迟并提升工具调用稳定性
# LLM_DISABLE_THINKING=1

# 强制使用内置演示引擎（不调用任何 LLM API）
# LLM_MODE=mock

# 向导里选择"先用离线演示模式"后置 1，避免每次进入都弹配置引导
# LLM_SETUP_SKIPPED=1

# ---------- 2) 编排引擎 ----------
#   langgraph → LangGraph supervisor 图（原生 function calling）【默认】
#   legacy    → 自研 ReAct 文本协议（显式回退；两者共享同一套工具/状态/知识库）
# ENGINE=langgraph

# ---------- 3) 联网检索（MCP，可选但推荐） ----------
# 通用联网检索（MCP: tavily_search / tavily_extract）。申请：https://tavily.com
# 未配置时：联网类 MCP 工具不可用，其余功能不受影响（模型用自身知识作答）。
TAVILY_API_KEY=
# 联网默认关闭；在网页「设置」中打开后才允许使用 Tavily
EDUOWL_WEB_ENABLED=0

# GitHub 检索配额（可选）。代码检索（github_search type=code）必须配置；
# 不配置也能检索仓库/issue，只是配额更低。申请：https://github.com/settings/tokens
GITHUB_TOKEN=

# ---------- 4) 向量检索（RAG，可选） ----------
# 默认使用本地 fastembed（零外部依赖，需 Python 环境，见 server/kb/embed_local.py）。
# 也可切换云服务：EMBED_PROVIDER=dashscope | siliconflow
# EMBED_PROVIDER=local
# EMBED_MODEL=bge-small-zh-v1.5
# DASHSCOPE_API_KEY=
# SILICONFLOW_API_KEY=

# Python 解释器路径（一般不用设；默认自动探测项目 venv → PATH 上的 python）
# PYTHON_BIN=

# ---------- 5) 其他 ----------
# 服务端口（默认 8787）
# PORT=8787
# 监听地址（默认 127.0.0.1）
# HOST=127.0.0.1
# 非回环监听必填。客户端可用 Authorization: Bearer <token>、X-Auth-Token，
# 或浏览器 Basic Auth（用户名任意，密码为此令牌）。
# EDUOWL_AUTH_TOKEN=
# 会话数据库路径（默认 data/app.db；测试用临时库隔离）
# EDUOWL_DB=
# 记忆引擎开关（默认开启）；off = 关闭会话总结/卡点/语义记忆
# MEMORY_ENABLED=off
# 允许网页读取工具访问内网地址（仅供本地调试，切勿在生产开启：会绕过 SSRF 防护）
# MCP_WEBTOOLS_ALLOW_PRIVATE=0

# ---------- 6) 检索质量 / 安全 / 成本（新增，一般无需修改） ----------
# 查询改写 + HyDE（提升口语化提问的召回率）；off = 只用原始问句检索
# KB_QUERY_REWRITE=on
# 答案忠实度核查（有检索来源时校验回答是否被支撑）；off = 关闭
# GROUNDING_CHECK=on
# 单会话 token 预算（0/未设 = 不限制；超限只告警不阻断）
# TOKEN_BUDGET_PER_SESSION=0
# 模型上下文预算（估算 token，供 legacy/LangGraph 共同裁剪历史；默认 12000）
# LLM_CONTEXT_TOKENS=12000
# 记忆回溯参与排序的候选消息数（默认 2000，越大越耗内存/检索时间）
# RECALL_CANDIDATES=2000
# 聊天图片/文件单个附件上限（默认 10MB；只影响对话附件，不影响课程素材上传）
# CHAT_ATTACHMENT_MAX_MB=10
# 模型单价表（覆盖内置默认，单位：美元/百万 token）：{"模型名":{"in":0.4,"out":1.2}}
# 未配置单价返回 cost=null（费用未知），显式 in=0/out=0 才表示免费；不要直接填人民币报价。
# TOKEN_PRICES_JSON=
