{
  "version": 1,
  "_comment": "MCP Server 注册表（可入库）。deny-by-default：Server 需 enabled:true 且 agents 列出角色才对该角色可见。密钥一律用 ${ENV} 引用 .env，不写明文。",
  "defaults": {
    "startTimeoutMs": 20000,
    "timeoutMs": 15000,
    "callsPerTurn": 2,
    "maxResultChars": 8000
  },
  "servers": {
    "webtools": {
      "label": "网页工具（自建 · stdio）",
      "description": "读取指定网页正文（HTML→文本），SSRF 防护：仅公网 http/https，内网/保留网段默认拒绝。",
      "enabled": true,
      "transport": "stdio",
      "command": "node",
      "args": [
        "server/mcp/servers/webtools.js"
      ],
      "env": {},
      "agents": [
        "learn",
        "review",
        "general"
      ],
      "tools": {
        "fetch_page": {
          "enabled": false
        },
        "server_info": {
          "enabled": true
        }
      }
    },
    "devsites": {
      "label": "权威站点（自建 · stdio）",
      "description": "编程 / AI 权威站点目录；互联网访问统一使用当前模型的原生搜索。",
      "enabled": true,
      "transport": "stdio",
      "command": "node",
      "args": [
        "server/mcp/servers/devsites.js"
      ],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      },
      "agents": [
        "learn",
        "review",
        "general"
      ],
      "timeoutMs": 22000,
      "tools": {
        "list_dev_sites": {
          "enabled": true
        },
        "github_search": {
          "enabled": false,
          "callsPerTurn": 2
        }
      }
    }
  }
}
